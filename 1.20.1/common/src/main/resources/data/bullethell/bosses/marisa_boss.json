{
  "id": "marisa_boss",
  "name": "Marisa Kirisame",
  "_design_notes": [
    "Inspired by Marisa's Imperishable Night (TH8) Stage 4B-style fight - feel-based, not a frame-perfect port.",
    "Phase flow: opening aimed pressure -> Magic Sign \"Milky Way\" -> nonspell -> Love Storm \"Starlight Typhoon\" (TH8) -> late nonspell (E/N lighter / H/L full) -> Love Sign \"Master Spark\" -> Comet Sign \"Blazing Star\" (E/N lighter / H/L full).",
    "Patterns favor AIMED, LASER_BEAM, and AIMED_RING (fan + ring) toward the nearest living player (co-op).",
    "LASER_ROTATING: bidirectional beams, one burst in the Typhoon phase for a laser-wheel moment.",
    "LASER: wide aimed beam (Master Spark). GOLD / STAR / RICE / SPARK / ORB as usual."
  ],
  "introDialog": [
    {
      "speaker": "BOSS",
      "text": "You made it this far? Color me impressed, ze. Now let's see if that luck holds!",
      "delayTicks": 160
    }
  ],
  "characterDialogs": {
    "reimu": [
      {
        "speaker": "BOSS",
        "text": "Yo, Reimu. I borrowed the good stuff first, try and take it back, ze!",
        "delayTicks": 160
      },
      {
        "speaker": "PLAYER",
        "text": "Return it now, Marisa. If not, I'll exterminate first and ask later.",
        "delayTicks": 130
      },
      {
        "speaker": "BOSS",
        "text": "Ha! Try exterminating after you survive this star shower, ze!",
        "delayTicks": 155
      }
    ],
    "marisa": [
      {
        "speaker": "BOSS",
        "text": "Hold up, another me? Then let's settle who's the real ordinary magician!",
        "delayTicks": 160
      },
      {
        "speaker": "PLAYER",
        "text": "Fine by me. Winner keeps the title and the Master Spark bragging rights!",
        "delayTicks": 130
      },
      {
        "speaker": "BOSS",
        "text": "Guess that means two Master Sparks, let's see whose is brighter, ze!",
        "delayTicks": 155
      }
    ],
    "sakuya": [
      {
        "speaker": "BOSS",
        "text": "Oh hey, Sakuya. Tell Patchy I'll return those books... eventually.",
        "delayTicks": 160
      },
      {
        "speaker": "PLAYER",
        "text": "Lady Patchouli sent me for them now. If needed, by force.",
        "delayTicks": 130
      },
      {
        "speaker": "BOSS",
        "text": "Knives versus lasers, bring it, I'll return the favor with interest!",
        "delayTicks": 155
      }
    ],
    "sanae": [
      {
        "speaker": "BOSS",
        "text": "Moriya's wind priestess, huh? Looking for faith points in a duel?",
        "delayTicks": 160
      },
      {
        "speaker": "PLAYER",
        "text": "Exactly. Beating you should make for excellent shrine publicity.",
        "delayTicks": 130
      },
      {
        "speaker": "BOSS",
        "text": "Great headline, hope your dodging keeps up with the front page, ze!",
        "delayTicks": 155
      }
    ],
    "cirno": [
      {
        "speaker": "BOSS",
        "text": "Cirno?! Alright, strongest fairy, try dodging my stars!",
        "delayTicks": 160
      },
      {
        "speaker": "PLAYER",
        "text": "I'll freeze your magic and prove who's strongest!",
        "delayTicks": 130
      },
      {
        "speaker": "BOSS",
        "text": "Ice versus stars, let's see which one shatters first!",
        "delayTicks": 150
      }
    ],
    "yuuka": [
      {
        "speaker": "BOSS",
        "text": "Yuuka?! What brings the flower master all the way to my forest, ze?",
        "delayTicks": 160
      },
      {
        "speaker": "PLAYER",
        "text": "I heard someone has been trampling the undergrowth during their research. Care to explain?",
        "delayTicks": 140
      },
      {
        "speaker": "BOSS",
        "text": "The mushrooms need room to breathe! And stars don't hurt anyone, ze!",
        "delayTicks": 155
      }
    ]
  },
  "victoryDialog": "Not bad at all. Next time I'll bring an even bigger spark, ze!",
  "defeatDialog": "Heh, stars don't lie. Come back after more practice.",
  "victoryDialogByCharacter": {
    "reimu": "You got me this round, Reimu. Don't get lazy just because you won.",
    "marisa": "What?! I lost to... me? Fine, you can borrow the title for now.",
    "sakuya": "Ow, those knives are no joke. Tell Patchy I still owe her... maybe.",
    "sanae": "Okay, miracle girl, that was flashy. I admit it, you earned that win.",
    "cirno": "Whoa, the strongest really did it. Remind me not to underestimate fairies.",
    "yuuka": "Beaten by a garden... I'll leave the undergrowth alone. Probably, ze."
  },
  "defeatDialogByCharacter": {
    "reimu": "That all you've got, shrine maiden? I expected cleaner dodging.",
    "marisa": "Fake or not, I'm still the one and only ordinary magician!",
    "sakuya": "Too slow, maid. Time waits for no one, especially not you.",
    "sanae": "Common sense from outside won't save you here, ze!",
    "cirno": "Even the strongest needs better footing. Try again, Cirno.",
    "yuuka": "Stars still outshine petals, ze. Bloom harder next time!"
  },
