{
  "id": "satori_boss",
  "name": "Satori Komeiji",
  "aura": {
    "texture": "textures/star_david.png",
    "spinDegsPerTick": 13.8,
    "baseScale": 2.85,
    "breathAmplitude": 0.10,
    "breathFrequency": 0.12,
    "growTicks": 20,
    "textureSize": 256,
    "tintR": 1.0,
    "tintG": 0.0,
    "tintB": 0.0,
    "tintA": 0.85
  },
  "_design_notes": [
    "SA Stage 4 boss. Phase structure mirrors TH11 Subterranean Animism Stage 4.",
    "Test: /bullethell start satori_boss 1 LUNATIC",
    "Reference: TH11 Stage 4 spell cards — Satori Komeiji, Palace of Earth Spirits."
  ],
  "introDialog": [
    {
      "speaker": "BOSS",
      "text": "I know exactly what you are thinking. Every move you plan, every gap you see — I have already seen it. Still, please come ahead.",
      "delayTicks": 185
    }
  ],
  "characterDialogs": {
    "reimu": [
      {
        "speaker": "BOSS",
        "text": "Shrine maiden. Your mind is a clean, direct thing — no scheming, no doubts. Just instinct.",
        "delayTicks": 165
      },
      {
        "speaker": "PLAYER",
        "text": "Less talking. More fighting.",
        "delayTicks": 105
      },
      {
        "speaker": "BOSS",
        "text": "... You thought that before I finished speaking. How refreshing.",
        "delayTicks": 150
      }
    ],
    "marisa": [
      {
        "speaker": "BOSS",
        "text": "A magician who steals freely and calls it collecting. Your heart is surprisingly untroubled by that.",
        "delayTicks": 175
      },
      {
        "speaker": "PLAYER",
        "text": "Being judged by a mind-reader? That ain't fair, ze.",
        "delayTicks": 120
      },
      {
        "speaker": "BOSS",
        "text": "Honesty is not the same as fairness. Now show me that unstoppable spark.",
        "delayTicks": 155
      }
    ],
    "sakuya": [
      {
        "speaker": "BOSS",
        "text": "The maid who stops time. Even so, your next intention is already visible to me.",
        "delayTicks": 170
      },
      {
        "speaker": "PLAYER",
        "text": "Can you read a mind that has already lived through the moment you are seeing?",
        "delayTicks": 138
      },
      {
        "speaker": "BOSS",
        "text": "... That is actually a fair question. Let us find out together.",
        "delayTicks": 148
      }
    ],
    "sanae": [
      {
        "speaker": "BOSS",
        "text": "A human who became a god's shrine maiden. Your memories are colourful. And very young.",
        "delayTicks": 170
      },
      {
        "speaker": "PLAYER",
        "text": "My faith does not need to be old to be real!",
        "delayTicks": 118
      },
      {
        "speaker": "BOSS",
        "text": "I believe you. That sincerity makes you harder to predict than most.",
        "delayTicks": 150
      }
    ],
    "cirno": [
      {
        "speaker": "BOSS",
        "text": "A fairy who truly, completely believes she is the strongest. There is not a single doubt in there.",
        "delayTicks": 165
      },
      {
        "speaker": "PLAYER",
        "text": "Because it is true! And your eye will not help if you cannot dodge ice!",
        "delayTicks": 125
      },
      {
        "speaker": "BOSS",
        "text": "I cannot argue with a mind that holds no room for argument. Very well, show me.",
        "delayTicks": 155
      }
    ],
    "yuuka": [
      {
        "speaker": "BOSS",
        "text": "...You are very quiet in there. Not calm — just vast. Like trying to read an entire forest.",
        "delayTicks": 175
      },
      {
        "speaker": "PLAYER",
        "text": "I hope it is not too overwhelming. I have had a long time to accumulate thoughts.",
        "delayTicks": 140
      },
      {
        "speaker": "BOSS",
        "text": "Most minds have edges. Yours simply does not. This may take a while.",
        "delayTicks": 160
      }
    ]
  },
  "victoryDialog": "Your mind moved faster than your body. That is usually how it ends.",
  "defeatDialog": "You emptied your thoughts... or perhaps you simply act before thinking. Either way, it worked.",
  "victoryDialogByCharacter": {
    "reimu": "Pure instinct. No room for me to slip between the thoughts.",
    "marisa": "You really do just go forward without a plan. It is somehow effective.",
    "sakuya": "A mind already living in the next moment — that is a genuine blind spot for me.",
    "sanae": "Your faith really does fill the space where doubt would be. I see that now.",
    "cirno": "The strongest, indeed. I could not read confidence that absolute.",
    "yuuka": "A mind with no readable edges... I cannot predict what was never there to find."
  },
  "defeatDialogByCharacter": {
    "reimu": "Instinct only gets you so far. Next time — think.",
    "marisa": "The spark burned bright, but brightness alone cannot fill every gap.",
    "sakuya": "Even a clock shows where the hands will be. I am simply a very attentive observer.",
    "sanae": "Faith without practice has its limits. Come back when the two have merged.",
    "cirno": "Strength is more than belief. But do keep believing — it suits you.",
    "yuuka": "Even a boundless mind has a turning point. I simply found which flower it was."
  },
