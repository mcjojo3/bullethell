  "_design_notes": [
    "Phase fields: tiered scalars use the same key as a number or [EASY, NORMAL, HARD, LUNATIC] array - see wiki Bosses-and-phases / Pattern-steps.",
    "Test: /bullethell start sanae_boss 1 LUNATIC",
    "Reference: https://touhou.fandom.com/wiki/Mountain_of_Faith:_Stage_5_Spell_Cards (TH10 Stage 5; finale Hard/Lunatic: Great Miracle \u00abYasaka's Divine Wind\u00bb / \u5927\u5947\u8de1\u300c\u516b\u5742\u306e\u795e\u98a8\u300d)."
  ],
  "introDialog": [
    {
      "speaker": "BOSS",
      "text": "The wind from Moriya carries my miracle. If you still stand here, face it with everything you have!",
      "delayTicks": 170
    }
  ],
  "characterDialogs": {
    "reimu": [
      {
        "speaker": "BOSS",
        "text": "Hakurei shrine maiden? Then you know faith is won in the sky, not on paper.",
        "delayTicks": 165
      },
      {
        "speaker": "PLAYER",
        "text": "I'll settle this incident whether your god helps or not.",
        "delayTicks": 130
      },
      {
        "speaker": "BOSS",
        "text": "Good. Show me that resolve in your dodging!",
        "delayTicks": 150
      }
    ],
    "marisa": [
      {
        "speaker": "BOSS",
        "text": "A magician from the forest? Don't expect miracles to wait politely in line.",
        "delayTicks": 165
      },
      {
        "speaker": "PLAYER",
        "text": "Miracles, stars, whatever \u2014 I'll graze through and steal the win, ze!",
        "delayTicks": 135
      },
      {
        "speaker": "BOSS",
        "text": "Then keep up with the wind until the last spell breaks!",
        "delayTicks": 155
      }
    ],
    "sakuya": [
      {
        "speaker": "BOSS",
        "text": "Scarlet Devil Mansion's maid, all the way up the mountain? You must be serious.",
        "delayTicks": 165
      },
      {
        "speaker": "PLAYER",
        "text": "Time is on my side \u2014 I'll clear your patterns all the same.",
        "delayTicks": 130
      },
      {
        "speaker": "BOSS",
        "text": "Then let the gale test whether your clocks can keep their tick.",
        "delayTicks": 155
      }
    ],
    "sanae": [
      {
        "speaker": "BOSS",
        "text": "Another me? Fine \u2014 let's see which faith the mountain answers!",
        "delayTicks": 165
      },
      {
        "speaker": "PLAYER",
        "text": "I'll prove I'm not just a copy!",
        "delayTicks": 115
      },
      {
        "speaker": "BOSS",
        "text": "Words won't decide it. The danmaku will.",
        "delayTicks": 145
      }
    ],
    "cirno": [
      {
        "speaker": "BOSS",
        "text": "A fairy climbed this high? Either brave or very lost.",
        "delayTicks": 160
      },
      {
        "speaker": "PLAYER",
        "text": "I'm the strongest! Your wind can't blow that away!",
        "delayTicks": 130
      },
      {
        "speaker": "BOSS",
        "text": "We'll see if ice can anchor you when the gale hits.",
        "delayTicks": 150
      }
    ],
    "yuuka": [
      {
        "speaker": "BOSS",
        "text": "Yuuka Kazami?! The Flower Master of the Four Seasons — here! This is incredible!",
        "delayTicks": 165
      },
      {
        "speaker": "PLAYER",
        "text": "You seem very enthusiastic. I hope the mountain hasn't made you this excitable about everything.",
        "delayTicks": 145
      },
      {
        "speaker": "BOSS",
        "text": "A miracle against the oldest flower in Gensokyo — I'm absolutely going to win this!",
        "delayTicks": 155
      }
    ]
  },
  "victoryDialog": "Amazing... even Kanako would call that a worthy miracle.",
  "defeatDialog": "Faith needs practice too. Come back when you're ready.",
  "victoryDialogByCharacter": {
    "reimu": "The Hakurei name shines even outside its shrine. Respect.",
    "marisa": "You really did bulldoze through \u2014 just try not to blow up the shrine, ze.",
    "sakuya": "Precision and nerve \u2014 Lady Remilia would notice that composure.",
    "sanae": "So I can lose to myself... guess I need more training.",
    "cirno": "Strongest fairy after all? I'll remember that chill.",
    "yuuka": "I beat the Flower Master? Even Kanako will hear about this one."
  },
  "defeatDialogByCharacter": {
    "reimu": "Your feet hesitated before your faith did.",
    "marisa": "Too greedy on the spark, not enough on the wind.",
    "sakuya": "Even perfect timing slips in a gale.",
    "sanae": "Miracles don't wait for doubt.",
    "cirno": "The strongest title needs more than bravado.",
    "yuuka": "The wind fades before roots this deep. Bloom more carefully next time."
  },
