{
  "id": "remilia_boss",
  "name": "Remilia Scarlet",
  "prerequisites": ["cirno_boss", "sakuya_boss"],
  "requirementSummary": "Defeat both Cirno and Sakuya first. Lowest clear difficulty is your cap.",
  "aura": {
    "texture": "textures/star_david.png",
    "spinDegsPerTick": 8.0,
    "baseScale": 2.0,
    "breathAmplitude": 0.10,
    "breathFrequency": 0.12,
    "growTicks": 20,
    "textureSize": 256,
    "tintR": 1.0,
    "tintG": 0.3,
    "tintB": 0.3,
    "tintA": 1.0
  },
  "introDialog": [
    {
      "speaker": "BOSS",
      "text": "Welcome to my castle at the end of the night. I am Remilia Scarlet - show me your fate.",
      "delayTicks": 170
    }
  ],
  "characterDialogs": {
    "reimu": [
      {
        "speaker": "BOSS",
        "text": "Hakurei shrine maiden, your fate brought you to my throne. Entertain me.",
        "delayTicks": 170
      },
      {
        "speaker": "PLAYER",
        "text": "Fine. I'll end this night and drag you into daylight.",
        "delayTicks": 130
      },
      {
        "speaker": "BOSS",
        "text": "Daylight? How quaint. Stay until I decide the moon's color.",
        "delayTicks": 160
      }
    ],
    "marisa": [
      {
        "speaker": "BOSS",
        "text": "Back again, little thief? Then steal your victory if you can.",
        "delayTicks": 170
      },
      {
        "speaker": "PLAYER",
        "text": "Heh, I was planning to. Add your title to the loot list, ze.",
        "delayTicks": 130
      },
      {
        "speaker": "BOSS",
        "text": "Bold words, prove your worth in scarlet wind before you count your spoils.",
        "delayTicks": 165
      }
    ],
    "sakuya": [
      {
        "speaker": "BOSS",
        "text": "A maid who turns her blades toward her mistress? Fascinating.",
        "delayTicks": 170
      },
      {
        "speaker": "PLAYER",
        "text": "Tonight I follow my own judgment.",
        "delayTicks": 120
      },
      {
        "speaker": "BOSS",
        "text": "Then let judgment be written in the rhythm of your blood.",
        "delayTicks": 155
      }
    ],
    "sanae": [
      {
        "speaker": "BOSS",
        "text": "A living god's priestess challenges a devil? Delightful irony.",
        "delayTicks": 170
      },
      {
        "speaker": "PLAYER",
        "text": "Then let's see whether destiny favors gods or devils.",
        "delayTicks": 130
      },
      {
        "speaker": "BOSS",
        "text": "Spoken well, now bleed poetry into the sky and show me.",
        "delayTicks": 160
      }
    ],
    "cirno": [
      {
        "speaker": "BOSS",
        "text": "A fairy at my doorstep. Are you lost, or merely fearless?",
        "delayTicks": 170
      },
      {
        "speaker": "PLAYER",
        "text": "Neither! I'm here to beat the final boss!",
        "delayTicks": 130
      },
      {
        "speaker": "BOSS",
        "text": "Final? Adorable. The night rewards those who outlast fairy tales.",
        "delayTicks": 165
      }
    ],
    "yuuka": [
      {
        "speaker": "BOSS",
        "text": "Yuuka Kazami. They say you have slept through entire ages of Gensokyo.",
        "delayTicks": 170
      },
      {
        "speaker": "PLAYER",
        "text": "They are not wrong. You were quite a young rumor the last time I stirred.",
        "delayTicks": 145
      },
      {
        "speaker": "BOSS",
        "text": "Young or not, fate has always favored the Scarlet name. Come — show me your season.",
        "delayTicks": 165
      }
    ]
  },
  "victoryDialog": "How unexpected... perhaps fate has teeth after all.",
  "defeatDialog": "Your fate was sealed the moment you stepped into my hall.",
  "victoryDialogByCharacter": {
    "reimu": "So this is the shrine maiden who defies destiny. Splendid.",
    "marisa": "You really did steal the night from me, magician.",
    "sakuya": "A blade turned inward can still cut deep. Well done.",
    "sanae": "Divine conviction overcame vampiric pride. Intriguing.",
    "cirno": "A fairy who reaches this throne... truly extraordinary.",
    "yuuka": "The garden endures longer than any mansion. Let us speak again in another century."
  },
  "defeatDialogByCharacter": {
    "reimu": "Even exorcists stumble in scarlet darkness.",
    "marisa": "Greed clouded your aim, little magician.",
    "sakuya": "Loyalty wavered, and so did your hand.",
    "sanae": "Faith falters when blood moonlight rises.",
    "cirno": "Bravery alone cannot rule the night.",
    "yuuka": "Even deep roots can be uprooted when fate turns its hand."
  },
